{
  "name": "@tieboyh/pi-feishu-bot",
  "version": "0.5.1",
  "description": "Feishu/Lark bot bridge for Pi with isolated persistent conversations and streaming cards",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src/**/*.ts",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test --timeout 20000 tests",
    "check": "bun run scripts/check-build.ts && tsc -p tsconfig.json",
    "verify": "npm test && npm run check",
    "prepack": "npm run verify"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "feishu",
    "lark",
    "bot"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tieboyh/pi-feishu-bot.git"
  },
  "homepage": "https://github.com/Tieboyh/pi-feishu-bot#readme",
  "bugs": {
    "url": "https://github.com/Tieboyh/pi-feishu-bot/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "pi-subagents": "^0.42.1",
    "proper-lockfile": "^4.1.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.13.3",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  }
}
