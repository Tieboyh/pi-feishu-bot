# Feishu Open Platform enterprise app credentials.
# Copy this file to ~/.pi/agent/state/pi-feishu-bot/.env and chmod 600.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Group chats require @mention by default. Set false to accept every group message.
FEISHU_REQUIRE_MENTION=true

# Optional conversation-pool limits.
FEISHU_MAX_CONVERSATIONS=20
FEISHU_IDLE_CONVERSATION_MS=1800000

# Optional group context prefetch. 0 disables it (default).
# When enabled, only an accepted group trigger fetches history; ordinary messages still receive no reply.
FEISHU_GROUP_CONTEXT_MESSAGES=0
FEISHU_GROUP_CONTEXT_LOOKBACK_MS=1800000
# bot: use this app bot (default); lark-cli-user: use the locally authorized user identity.
FEISHU_GROUP_CONTEXT_SOURCE=bot

# Optional fixed-group lifecycle notification tool.
# The custom-bot webhook fixes the recipient; callers only provide title and message.
FEISHU_NOTIFY_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# Default 10000; valid range 1-60000 milliseconds.
FEISHU_NOTIFY_TIMEOUT_MS=10000
